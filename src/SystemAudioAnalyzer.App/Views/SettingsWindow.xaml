<Window x:Class="SystemAudioAnalyzer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SystemAudioAnalyzer.App.ViewModels"
        xmlns:settings="clr-namespace:SystemAudioAnalyzer.App.Settings"
        Title="Настройки измерений" Width="560" Height="420" WindowStartupLocation="CenterOwner" Background="#111827" Foreground="#E5E7EB">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl x:Name="Pages">
            <TabItem Header="Analyzer"><StackPanel Margin="16"><TextBlock Text="FFT size и окно: фиксированы текущим движком"/><TextBlock Text="Floor отображения (dB)" Margin="0,14,0,2"/><TextBox Text="{Binding AnalyzerFloorDb, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Cursor color (#RRGGBB)" Margin="0,10,0,0"/><TextBox Text="{Binding AnalyzerCursorColor, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Text color (#RRGGBB)" Margin="0,10,0,0"/><TextBox Text="{Binding AnalyzerTextColor, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Изменение параметров FFT станет доступно после расширения Core." Foreground="#9CA3AF" Margin="0,12,0,0"/></StackPanel></TabItem>
            <TabItem Header="Waterfall"><StackPanel Margin="16"><TextBlock Text="Display floor (dB)"/><TextBox Text="{Binding WaterfallFloorDb, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Display offset (dB)" Margin="0,10,0,0"/><TextBox Text="{Binding WaterfallOffsetDb, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Palette color (#RRGGBB)" Margin="0,10,0,0"/><TextBox Text="{Binding WaterfallPaletteColor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></TabItem>
            <TabItem Header="Meters"><StackPanel Margin="16"><TextBlock Text="Display range (dB)"/><TextBox Text="{Binding MeterRangeDb, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Meter color (#RRGGBB)" Margin="0,10,0,0"/><TextBox Text="{Binding MeterColor, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Overload color (#RRGGBB)" Margin="0,10,0,0"/><TextBox Text="{Binding OverloadColor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></TabItem>
            <TabItem Header="Loudness"><StackPanel Margin="16"><TextBlock Text="History window (seconds)"/><TextBox Text="{Binding LoudnessHistorySeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Metric" Margin="0,10,0,0"/><ComboBox SelectedValue="{Binding LoudnessMetric}" SelectedValuePath="Tag"><ComboBoxItem Content="Momentary" Tag="{x:Static settings:LoudnessMetric.Momentary}"/><ComboBoxItem Content="Short-term" Tag="{x:Static settings:LoudnessMetric.ShortTerm}"/><ComboBoxItem Content="Integrated" Tag="{x:Static settings:LoudnessMetric.Integrated}"/></ComboBox><CheckBox Content="Automatic scale" IsChecked="{Binding LoudnessAutoScale}" Margin="0,10,0,0"/><TextBlock Text="Span (LUFS)" Margin="0,10,0,0"/><TextBox Text="{Binding LoudnessSpan, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Centre (LUFS)" Margin="0,10,0,0"/><TextBox Text="{Binding LoudnessCentre, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></TabItem>
            <TabItem Header="RTA"><StackPanel Margin="16"><TextBlock Text="Source"/><ComboBox SelectedValue="{Binding RtaSource}" SelectedValuePath="Tag"><ComboBoxItem Content="Mono (L+R)" Tag="{x:Static viewModels:RtaChannelMode.Mono}"/><ComboBoxItem Content="Left" Tag="{x:Static viewModels:RtaChannelMode.Left}"/><ComboBoxItem Content="Right" Tag="{x:Static viewModels:RtaChannelMode.Right}"/></ComboBox><TextBlock Text="Resolution" Margin="0,10,0,0"/><ComboBox SelectedValue="{Binding RtaResolution}" SelectedValuePath="Tag"><ComboBoxItem Content="1/1 octave" Tag="{x:Static viewModels:RtaResolution.One}"/><ComboBoxItem Content="1/3 octave" Tag="{x:Static viewModels:RtaResolution.OneThird}"/><ComboBoxItem Content="1/6 octave" Tag="{x:Static viewModels:RtaResolution.OneSixth}"/><ComboBoxItem Content="1/12 octave" Tag="{x:Static viewModels:RtaResolution.OneTwelfth}"/></ComboBox><TextBlock Text="Scale top (dB)" Margin="0,10,0,0"/><TextBox Text="{Binding RtaScaleTop, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Scale range (dB)" Margin="0,10,0,0"/><TextBox Text="{Binding RtaScaleRange, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Target line (dB)" Margin="0,10,0,0"/><TextBox Text="{Binding RtaTargetLine, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></TabItem>
            <TabItem Header="Phase"><StackPanel Margin="16"><TextBlock Text="Gain compensation"/><Slider Minimum="0.25" Maximum="4" Value="{Binding PhaseGain}"/><TextBlock Text="{Binding PhaseGain, StringFormat=Gain: {0:F2}}"/></StackPanel></TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Применить" Click="Apply" Width="100" Margin="4,0"/><Button Content="OK" Click="Accept" Width="84" Margin="4,0"/><Button Content="Отмена" Click="Cancel" Width="84" Margin="4,0"/></StackPanel>
    </Grid>
</Window>
