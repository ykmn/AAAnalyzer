<Window x:Class="SystemAudioAnalyzer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки измерений" Width="560" Height="420" WindowStartupLocation="CenterOwner" Background="#111827" Foreground="#E5E7EB">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl x:Name="Pages"><TabItem Header="Analyzer"><TextBlock Text="Параметры FFT будут доступны после расширения Core." Margin="16"/></TabItem><TabItem Header="Waterfall"><TextBlock Text="Floor, offset и палитра Waterfall." Margin="16"/></TabItem><TabItem Header="Meters"><TextBlock Text="Диапазон и цвета индикаторов." Margin="16"/></TabItem><TabItem Header="Loudness"><TextBlock Text="История, метрика и масштаб LUFS." Margin="16"/></TabItem><TabItem Header="RTA"><TextBlock Text="Источник, разрешение и target line." Margin="16"/></TabItem><TabItem Header="Phase"><TextBlock Text="Компенсация gain фазоскопа." Margin="16"/></TabItem></TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="OK" Click="Accept" Width="84" Margin="4,0"/><Button Content="Отмена" Click="Cancel" Width="84" Margin="4,0"/></StackPanel>
    </Grid>
</Window>
