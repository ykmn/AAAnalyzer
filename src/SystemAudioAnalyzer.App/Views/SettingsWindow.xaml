<Window x:Class="SystemAudioAnalyzer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SystemAudioAnalyzer.App.Localization"
        Title="{loc:Tr SettingsTitle}" Width="480" Height="768" MinWidth="460" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#F4F4F4" Foreground="#111111">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Tr Language}" Width="76" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" DisplayMemberPath="Label" SelectedValuePath="Value"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Tr Preset}" Width="76" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfileId, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Tr SaveAs}" Width="76" VerticalAlignment="Center"/>
                <Button Content="{loc:Tr Delete}" Click="DeleteProfile" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"/>
                <Button Content="{loc:Tr Save}" Click="SaveProfile" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"/>
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <Button Content="{loc:Tr MakeDefault}" Click="SetDefault" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <TabControl x:Name="Pages" Grid.Row="1" Background="#F4F4F4" SelectionChanged="PageSelectionChanged">
            <TabItem Header="{loc:Tr Tab_Analyzer}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                <DockPanel><TextBlock Text="{loc:Tr FftSize}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding FftSizes}" SelectedItem="{Binding AnalyzerFftSize}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr Window}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding WindowFunctions}" SelectedItem="{Binding AnalyzerWindowFunction}"/></DockPanel>
                <CheckBox Content="{loc:Tr LogFrequency}" IsChecked="{Binding IsLogarithmicFrequencyScale}" Margin="0,6,0,0"/>
                <CheckBox Content="{loc:Tr LogAmplitude}" IsChecked="{Binding IsLogarithmicAmplitudeScale}" Margin="0,4,0,0"/>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr MinLevel}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding AnalyzerFloorDb, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr Gain}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding AnalyzerGain, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr CursorColor}" Width="190" TextWrapping="Wrap"/><Button Tag="AnalyzerCursorColor" Background="{Binding AnalyzerCursorColor}" Click="PickColor" Width="60" Height="23" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr TextColor}" Width="190" TextWrapping="Wrap"/><Button Tag="AnalyzerTextColor" Background="{Binding AnalyzerTextColor}" Click="PickColor" Width="60" Height="23" HorizontalAlignment="Left"/></DockPanel>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="{loc:Tr Tab_Waterfall}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                <DockPanel><TextBlock Text="{loc:Tr DisplayFloor}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding WaterfallFloorDb, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr DisplayOffset}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding WaterfallOffsetDb, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,4"><TextBlock Text="{loc:Tr PaletteColor}" Width="190" TextWrapping="Wrap"/><Button Tag="WaterfallPaletteColor" Background="{Binding WaterfallPaletteColor}" Click="PickColor" Width="60" Height="23" HorizontalAlignment="Left"/></DockPanel>
                <TextBlock Text="{loc:Tr GradientDb}" Margin="0,6,0,2"/>
                <ListBox ItemsSource="{Binding GradientStops}" SelectedItem="{Binding SelectedGradientStop}" Height="170">
                    <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2"><Border Width="32" Height="16" Background="{Binding Color}" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0"/><TextBlock VerticalAlignment="Center"><Run Text="{Binding LevelDb, Mode=OneWay, StringFormat={}{0:G}}"/><Run Text="{loc:Tr UnitDb}"/></TextBlock></DockPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr StopLevelDb}" Width="100" VerticalAlignment="Center"/><TextBox Text="{Binding SelectedGradientLevel, UpdateSourceTrigger=PropertyChanged}" Width="145"/>
                    <Button Content="{loc:Tr ColorButton}" Click="PickGradientColor" Margin="6,0,0,0" Padding="8,2"/><Button Content="{loc:Tr Add}" Click="AddGradientStop" Margin="6,0,0,0" Padding="10,2"/><Button Content="{loc:Tr Delete}" Click="DeleteGradientStop" IsEnabled="{Binding CanDeleteGradientStop}" Margin="6,0,0,0" Padding="8,2"/>
                </DockPanel>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="{loc:Tr Tab_Meters}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                <DockPanel><TextBlock Text="{loc:Tr Attack}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding MeterAttackMs, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr Release}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding MeterReleaseMs, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr PeakHold}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding MeterPeakHoldMs, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr MeterRange}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding MeterRangeDb, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <CheckBox Content="{loc:Tr ShowClip}" IsChecked="{Binding ShowClipAndPeakReadout}" Margin="0,7,0,0"/>
                <CheckBox Content="{loc:Tr NoRms}" IsChecked="{Binding DisableRmsBar}" Margin="0,6,0,0"/>
                <CheckBox Content="{loc:Tr ShowDbScale}" IsChecked="{Binding ShowDbScale}" Margin="0,6,0,0"/>
                <CheckBox Content="{loc:Tr ShowLufsIndicator}" IsChecked="{Binding ShowLufsIndicator}" Margin="0,6,0,0"/>
                <DockPanel Margin="0,7,0,0"><TextBlock Text="{loc:Tr LufsBarShows}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding LoudnessMetricOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MeterLufsMetric}"/></DockPanel>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr IntegratedWindow}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding IntegratedWindowSeconds, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <CheckBox Content="{loc:Tr ShowLkfs}" IsChecked="{Binding ShowLkfsReadout}" Margin="0,6,0,0"/>
                <DockPanel Margin="0,7,0,0"><TextBlock Text="{loc:Tr FontSize}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding MeterFontSizeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MeterFontSize}"/></DockPanel>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr LufsScale}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding LufsScaleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LufsScale}"/></DockPanel>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr LufsScaleParameters}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding LufsScaleTop, UpdateSourceTrigger=PropertyChanged}" Width="55"/><TextBox Text="{Binding LufsScaleBottom, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="4,0,0,0"/><TextBox Text="{Binding LufsScaleStep, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="4,0,0,0"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr PeakColor}" Width="190" TextWrapping="Wrap"/><Button Tag="PeakColor" Background="{Binding PeakColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,4,0,0"><TextBlock Text="{loc:Tr RmsColor}" Width="190" TextWrapping="Wrap"/><Button Tag="RmsColor" Background="{Binding RmsColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,4,0,0"><TextBlock Text="{loc:Tr LufsColor}" Width="190" TextWrapping="Wrap"/><Button Tag="LufsColor" Background="{Binding LufsColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,4,0,0"><TextBlock Text="{loc:Tr ClipColor}" Width="190" TextWrapping="Wrap"/><Button Tag="ClipColor" Background="{Binding ClipColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,4,0,0"><TextBlock Text="{loc:Tr MeterColorCompat}" Width="190" TextWrapping="Wrap"/><Button Tag="MeterColor" Background="{Binding MeterColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,4,0,0"><TextBlock Text="{loc:Tr OverloadColorCompat}" Width="190" TextWrapping="Wrap"/><Button Tag="OverloadColor" Background="{Binding OverloadColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="{loc:Tr Tab_Loudness}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                <DockPanel><TextBlock Text="{loc:Tr LoudnessWindow}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding LoudnessHistorySeconds, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr Mode}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding LoudnessMetricOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LoudnessMetric}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr YSpan}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding LoudnessSpan, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr YCenter}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding LoudnessCentre, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr TargetLine}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding LoudnessTarget, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr TargetRangeLu}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding LoudnessTargetRange, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <TextBlock Text="{loc:Tr ColorGradientLufs}" Margin="0,7,0,2"/>
                <ListBox ItemsSource="{Binding GradientStops}" SelectedItem="{Binding SelectedGradientStop}" Height="150">
                    <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2"><Border Width="32" Height="16" Background="{Binding Color}" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0"/><TextBlock VerticalAlignment="Center"><Run Text="{Binding LevelDb, Mode=OneWay, StringFormat={}{0:G}}"/><Run Text="{loc:Tr UnitLufs}"/></TextBlock></DockPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr StopLevelLufs}" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding SelectedGradientLevel, UpdateSourceTrigger=PropertyChanged}" Width="145"/>
                    <Button Content="{loc:Tr ColorButton}" Click="PickGradientColor" Margin="6,0,0,0" Padding="8,2"/><Button Content="{loc:Tr Add}" Click="AddGradientStop" Margin="6,0,0,0" Padding="10,2"/><Button Content="{loc:Tr Delete}" Click="DeleteGradientStop" IsEnabled="{Binding CanDeleteGradientStop}" Margin="6,0,0,0" Padding="8,2"/>
                </DockPanel>
                <Button Content="{loc:Tr SaveRuntime}" Click="SaveRuntimeAsDefault" Margin="0,8,0,0"/>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="{loc:Tr Tab_Rta}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                <DockPanel><TextBlock Text="{loc:Tr Source}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding RtaSourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RtaSource}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr Resolution}" Width="190" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding RtaResolutionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RtaResolution}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr Averaging}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding RtaAveragingCount, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr TiltLabel}" Width="190" TextWrapping="Wrap" ToolTip="{loc:Tr TiltHelp}"/><TextBox Text="{Binding RtaTiltDbPerOctave, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr RtaRelease}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding RtaReleaseDbPerSecond, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr ScaleTop}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding RtaScaleTop, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr ScaleRange}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding RtaScaleRange, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr RtaTargetLine}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding RtaTargetLine, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr RtaTargetRange}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding RtaTargetRange, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <CheckBox Content="{loc:Tr ShowCaps}" IsChecked="{Binding ShowRtaPeakHoldCaps}" Margin="0,7,0,0"/>
                <DockPanel Margin="0,6,0,0"><TextBlock Text="{loc:Tr PeakHold}" Width="190" TextWrapping="Wrap"/><TextBox Text="{Binding RtaPeakHoldMs, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                <DockPanel Margin="0,5,0,0"><TextBlock Text="{loc:Tr BarColor}" Width="190" TextWrapping="Wrap"/><Button Tag="RtaBarColor" Background="{Binding RtaBarColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,4,0,0"><TextBlock Text="{loc:Tr PeakCapColor}" Width="190" TextWrapping="Wrap"/><Button Tag="RtaPeakCapColor" Background="{Binding RtaPeakCapColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="0,4,0,0"><TextBlock Text="{loc:Tr TargetBandColor}" Width="190" TextWrapping="Wrap"/><Button Tag="RtaTargetBandColor" Background="{Binding RtaTargetBandColor}" Click="PickColor" Width="60" Height="22" HorizontalAlignment="Left"/></DockPanel>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="{loc:Tr Tab_Phase}"><StackPanel Margin="8"><TextBlock Text="{loc:Tr GainCompensation}"/><Slider Minimum="0.25" Maximum="4" Value="{Binding PhaseGain, UpdateSourceTrigger=PropertyChanged}"/><TextBlock><Run Text="{loc:Tr GainValue}"/><Run Text="{Binding PhaseGain, Mode=OneWay, StringFormat={}{0:F2}}"/></TextBlock></StackPanel></TabItem>
        </TabControl>

        <TextBlock x:Name="SaveError" Grid.Row="2" Foreground="#B00020" TextWrapping="Wrap" Margin="4,8,4,0"/>
        <StackPanel Grid.Row="3" Margin="2,10,2,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Tr Apply}" Click="Apply" MinWidth="74" Margin="4,0"/>
                <Button Content="{loc:Tr Ok}" Click="Accept" MinWidth="74" Margin="4,0"/>
                <Button Content="{loc:Tr Cancel}" Click="Cancel" MinWidth="74" Margin="4,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
