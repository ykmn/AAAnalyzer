<Window x:Class="SystemAudioAnalyzer.App.Views.UrlLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SystemAudioAnalyzer.App.Localization"
        Title="{loc:Tr UrlLibraryTitle}" Width="640" Height="480" MinWidth="480" MinHeight="320"
        Background="#0B0F14" Foreground="#E5E7EB">
    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2C3645" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3E4B5E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource ToolButton}" Content="{loc:Tr UrlLibraryAdd}" Click="Add" />
            <Button Style="{StaticResource ToolButton}" Content="{loc:Tr UrlLibrarySave}" Click="SaveEdit" Margin="6,0,0,0" />
            <Button Style="{StaticResource ToolButton}" Content="{loc:Tr UrlLibraryRemove}" Click="Remove" Margin="6,0,0,0" />
            <Button Style="{StaticResource ToolButton}" Content="▲" Click="MoveUp" Margin="18,0,0,0" ToolTip="{loc:Tr UrlLibraryMoveUpTip}" />
            <Button Style="{StaticResource ToolButton}" Content="▼" Click="MoveDown" Margin="6,0,0,0" ToolTip="{loc:Tr UrlLibraryMoveDownTip}" />
            <Button Style="{StaticResource ToolButton}" Content="{loc:Tr UrlLibraryImport}" Click="ImportPlaylist" Margin="18,0,0,0" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  Background="#10151C" Foreground="#E5E7EB" BorderThickness="0" MouseDoubleClick="ActivateSelected">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:Tr UrlLibraryName}" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="{loc:Tr UrlLibraryUrl}" Width="380" DisplayMemberBinding="{Binding Url}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Tr UrlLibraryName}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Height="24" />
            <TextBlock Grid.Column="3" Text="{loc:Tr UrlLibraryUrl}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="4" Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Height="24" />
        </Grid>
    </Grid>
</Window>
