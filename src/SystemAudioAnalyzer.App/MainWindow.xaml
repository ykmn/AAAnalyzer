<Window x:Class="SystemAudioAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:SystemAudioAnalyzer.App.Rendering"
        xmlns:vm="clr-namespace:SystemAudioAnalyzer.App.ViewModels"
        Title="AA Analyzer" Width="1440" Height="900" MinWidth="900" MinHeight="650" Background="#0B0F14" Foreground="#E5E7EB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <vm:ValueMatchConverter x:Key="Match" />
        <!-- Default RadioButton ignores the window Foreground and renders black text on the dark background. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E5E7EB" />
        </Style>
        <Style x:Key="PaneBase" TargetType="Grid">
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Background" Value="#080B10" />
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,6" Background="#10151C" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Margin="8,4" VerticalAlignment="Center">
                <TextBlock Text="AA" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="ANALYZER" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,3,18,0" />
                <TextBlock Text="ИСТОЧНИК" Foreground="#9CA3AF" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton Content="Устройство" GroupName="SourceMode" IsChecked="{Binding IsDeviceMode}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton Content="Поток" GroupName="SourceMode" IsChecked="{Binding IsStreamMode}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="320" Height="26" VerticalContentAlignment="Center" FontSize="10" Visibility="{Binding IsDeviceMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Text="{Binding StreamUrl, UpdateSourceTrigger=PropertyChanged}" Width="320" Height="26" VerticalContentAlignment="Center" FontSize="10" Visibility="{Binding IsStreamMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Content="СТАРТ" Command="{Binding StartCommand}" Width="80" Height="26" Margin="10,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RunState}" Value="Running"><Setter Property="Background" Value="#1F7A45" /><Setter Property="Foreground" Value="White" /></DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Starting"><Setter Property="Background" Value="#9A6B12" /><Setter Property="Foreground" Value="White" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="СТОП" Command="{Binding StopCommand}" Width="80" Height="26" Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RunState}" Value="Stopped"><Setter Property="Background" Value="#8B2E2E" /><Setter Property="Foreground" Value="White" /></DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Faulted"><Setter Property="Background" Value="#8B2E2E" /><Setter Property="Foreground" Value="White" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <rendering:MeterRailView Grid.Row="1" x:Name="MeterRail" Frame="{Binding LatestFrame}" Settings="{Binding MeasurementSettings}" />

        <Grid Grid.Row="1" Grid.Column="2" Background="#080B10">
            <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Background="#10151C">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="СБРОС" Click="ResetPane" />
                    <Button Style="{StaticResource ToolButton}" Content="PNG" Click="SaveScreenshot" />
                    <Button Style="{StaticResource ToolButton}" Content="НАСТРОЙКИ" Click="OpenSettings" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ToolRadio}" GroupName="Tabs" Content="Waterfall" IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=Waterfall}" />
                    <RadioButton Style="{StaticResource ToolRadio}" GroupName="Tabs" Content="Loudness" IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=Loudness}" />
                    <RadioButton Style="{StaticResource ToolRadio}" GroupName="Tabs" Content="RTA" IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=Rta}" />
                    <RadioButton Style="{StaticResource ToolRadio}" GroupName="Tabs" Content="Phase" IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=Phase}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid x:Name="WaterfallPane">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PaneBase}">
                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTab}" Value="Waterfall"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <rendering:WaterfallView x:Name="WaterfallView" Frame="{Binding LatestFrame}" Settings="{Binding MeasurementSettings}" />
                </Grid>

                <Grid x:Name="LoudnessPane">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PaneBase}">
                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTab}" Value="Loudness"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Metric" Content="Momentary" IsChecked="{Binding LoudnessMetric, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=Momentary}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Metric" Content="Short-Term" IsChecked="{Binding LoudnessMetric, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=ShortTerm}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Metric" Content="Integrated" IsChecked="{Binding LoudnessMetric, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=Integrated}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="22" FontWeight="Bold" Foreground="#4CAF50" Text="{Binding CurrentLoudnessText}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="1m" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=60}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="2m" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=120}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="3m" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=180}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="5m" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=300}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="10m" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=600}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="20m" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=1200}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="30m" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=1800}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="1h" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=3600}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="6h" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=21600}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="Window" Content="12h" IsChecked="{Binding LoudnessWindowSeconds, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=43200}" />
                        <Button Style="{StaticResource ToolButton}" Content="Y−" Margin="10,0,1,0" Click="LoudnessZoomOut" />
                        <Button Style="{StaticResource ToolButton}" Content="Y+" Click="LoudnessZoomIn" />
                        <TextBlock Text="{Binding LoudnessScaleText}" VerticalAlignment="Center" Margin="8,0" FontSize="11" Foreground="#9CA3AF" />
                        <Button Style="{StaticResource ToolButton}" Content="▼" Click="LoudnessShiftDown" />
                        <Button Style="{StaticResource ToolButton}" Content="▲" Click="LoudnessShiftUp" />
                    </StackPanel>
                    <rendering:LoudnessView x:Name="LoudnessView" Grid.Row="2" Frame="{Binding LatestFrame}" Settings="{Binding MeasurementSettings}" />
                </Grid>

                <Grid x:Name="RtaPane">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PaneBase}">
                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTab}" Value="Rta"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="RtaSource" Content="Mono" IsChecked="{Binding IsRtaMono, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="RtaSource" Content="L" IsChecked="{Binding IsRtaLeft, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="RtaSource" Content="R" IsChecked="{Binding IsRtaRight, Mode=TwoWay}" Margin="1,0,12,0" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="RtaResolution" Content="1/1" IsChecked="{Binding RtaResolution, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=One}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="RtaResolution" Content="1/3" IsChecked="{Binding RtaResolution, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=OneThird}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="RtaResolution" Content="1/6" IsChecked="{Binding RtaResolution, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=OneSixth}" />
                        <RadioButton Style="{StaticResource ToolRadio}" GroupName="RtaResolution" Content="1/12" IsChecked="{Binding RtaResolution, Mode=TwoWay, Converter={StaticResource Match}, ConverterParameter=OneTwelfth}" Margin="1,0,12,0" />
                        <Button Style="{StaticResource ToolButton}" Content="−" Click="RtaAverageDown" />
                        <TextBlock Text="{Binding RtaAverageText}" VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#D6DCE5" />
                        <Button Style="{StaticResource ToolButton}" Content="+" Click="RtaAverageUp" />
                        <Button Style="{StaticResource ToolButton}" Content="−" Margin="12,0,1,0" Click="RtaTargetDown" />
                        <TextBlock Text="{Binding RtaTargetText}" VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#D6DCE5" />
                        <Button Style="{StaticResource ToolButton}" Content="+" Click="RtaTargetUp" />
                    </StackPanel>
                    <rendering:RtaView x:Name="RtaView" Grid.Row="1" Frame="{Binding LatestFrame}" Resolution="{Binding RtaResolution}" ChannelMode="{Binding RtaChannelMode}" Settings="{Binding MeasurementSettings}" />
                </Grid>

                <Grid x:Name="PhasePane">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PaneBase}">
                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTab}" Value="Phase"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Slider x:Name="PhaseGain" Minimum="0.25" Maximum="4" Value="{Binding PhaseGain, UpdateSourceTrigger=PropertyChanged}" Margin="6,6,6,0" />
                    <rendering:PhaseScopeView Grid.Row="1" Frame="{Binding LatestFrame}" Gain="{Binding PhaseGain}" Settings="{Binding MeasurementSettings}" Margin="8" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#10151C" CornerRadius="3" Padding="8,4" Margin="0,6,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticsText}" FontSize="11" Foreground="#7F8B99" Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
