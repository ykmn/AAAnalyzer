<Window x:Class="SystemAudioAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:SystemAudioAnalyzer.App.Rendering"
        Title="AA Analyzer" Width="1440" Height="900" MinWidth="900" MinHeight="650" Background="#111827" Foreground="#E5E7EB">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="AA" FontSize="22" FontWeight="Bold" /><TextBlock Text="ANALYZER" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,18" />
            <TextBlock Text="ИСТОЧНИК" Foreground="#9CA3AF" FontSize="10" />
            <RadioButton Content="Устройство" GroupName="SourceMode" IsChecked="{Binding IsDeviceMode}" FontSize="10" /><RadioButton Content="Поток" GroupName="SourceMode" IsChecked="{Binding IsStreamMode}" FontSize="10" />
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Height="28" FontSize="10" Visibility="{Binding IsDeviceMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBox Text="{Binding StreamUrl, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="10" Visibility="{Binding IsStreamMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="СТАРТ" Command="{Binding StartCommand}" Height="30" Margin="0,10,0,0" FontSize="10" /><Button Content="СТОП" Command="{Binding StopCommand}" Height="26" Margin="0,5,0,0" FontSize="10" />
            <Separator Margin="0,18,0,10" /><TextBlock Text="TRUE PEAK" Foreground="#9CA3AF" FontSize="10" /><rendering:MeterRailView Frame="{Binding LatestFrame}" Height="320" Margin="0,6,0,0" />
        </StackPanel>
        <TabControl Grid.Column="2" Background="#0B1220" BorderThickness="0">
            <TabItem Header="WATERFALL"><Grid x:Name="WaterfallPane" Background="#0B1220"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="14,8"><TextBlock Text="WATERFALL · L / R · 10 s" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="СБРОС" Click="ResetPane"/><Button Content="PNG" Tag="WaterfallPane" Click="SaveScreenshot"/><Button Content="НАСТРОЙКИ" Tag="Waterfall" Click="OpenSettings"/></StackPanel></DockPanel><rendering:WaterfallView x:Name="WaterfallView" Grid.Row="1" Frame="{Binding LatestFrame}"/></Grid></TabItem>
            <TabItem Header="RTA"><Grid x:Name="RtaPane" Background="#0B1220"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,8"><DockPanel><TextBlock Text="RTA" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="СБРОС" Click="ResetPane"/><Button Content="PNG" Tag="RtaPane" Click="SaveScreenshot"/><Button Content="НАСТРОЙКИ" Tag="Rta" Click="OpenSettings"/></StackPanel></DockPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="1/1" Tag="One" Click="SetRtaResolution"/><Button Content="1/3" Tag="OneThird" Click="SetRtaResolution"/><Button Content="1/6" Tag="OneSixth" Click="SetRtaResolution"/><Button Content="1/12" Tag="OneTwelfth" Click="SetRtaResolution"/><RadioButton Content="Mono" Tag="Mono" Click="SetRtaChannel" IsChecked="True" Margin="16,0,0,0"/><RadioButton Content="L" Tag="Left" Click="SetRtaChannel"/><RadioButton Content="R" Tag="Right" Click="SetRtaChannel"/></StackPanel></StackPanel><rendering:RtaView Grid.Row="1" Frame="{Binding LatestFrame}" Resolution="{Binding RtaResolution}" ChannelMode="{Binding RtaChannelMode}" Margin="14"/></Grid></TabItem>
            <TabItem Header="LOUDNESS"><Grid x:Name="LoudnessPane" Background="#0B1220"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="14,8"><StackPanel><TextBlock Text="LOUDNESS · EBU R128" FontWeight="SemiBold"/><TextBlock Text="Momentary · Short-term · Integrated" Foreground="#9CA3AF" FontSize="10"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="СБРОС" Click="ResetPane"/><Button Content="PNG" Tag="LoudnessPane" Click="SaveScreenshot"/><Button Content="НАСТРОЙКИ" Tag="Loudness" Click="OpenSettings"/></StackPanel></DockPanel><rendering:LoudnessView x:Name="LoudnessView" Grid.Row="1" Frame="{Binding LatestFrame}" Margin="14"/></Grid></TabItem>
            <TabItem Header="PHASE SCOPE"><Grid x:Name="PhasePane" Background="#0B1220"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,8"><DockPanel><TextBlock Text="PHASE SCOPE" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="СБРОС" Click="ResetPane"/><Button Content="PNG" Tag="PhasePane" Click="SaveScreenshot"/><Button Content="НАСТРОЙКИ" Tag="Phase" Click="OpenSettings"/></StackPanel></DockPanel><Slider x:Name="PhaseGain" Minimum="0.25" Maximum="4" Value="1" Margin="0,8,0,0"/></StackPanel><rendering:PhaseScopeView Grid.Row="1" Frame="{Binding LatestFrame}" Gain="{Binding ElementName=PhaseGain, Path=Value}" Margin="14"/></Grid></TabItem>
        </TabControl>
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#172033" CornerRadius="5" Padding="8" Margin="0,12,0,0"><TextBlock Text="{Binding StatusText}" FontSize="11"/></Border>
    </Grid>
</Window>
