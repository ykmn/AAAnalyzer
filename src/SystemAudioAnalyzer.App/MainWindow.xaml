<Window x:Class="SystemAudioAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SystemAudioAnalyzer.App.ViewModels"
        xmlns:rendering="clr-namespace:SystemAudioAnalyzer.App.Rendering"
        Title="AA Analyzer" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="#111827" Foreground="#E5E7EB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
            <TextBlock Text="AA ANALYZER" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,22" />
            <TextBlock Text="ИСТОЧНИК" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="Устройство" GroupName="SourceMode" IsChecked="{Binding IsDeviceMode}" Margin="0,0,14,0" />
                <RadioButton Content="Поток" GroupName="SourceMode" IsChecked="{Binding IsStreamMode}" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="Name" Height="32"
                      Visibility="{Binding IsDeviceMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBox Text="{Binding StreamUrl, UpdateSourceTrigger=PropertyChanged}" Height="32"
                     ToolTip="http:// или https:// ссылка на Icecast/HLS"
                     Visibility="{Binding IsStreamMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,16" />
            <Button Content="СТАРТ" Command="{Binding StartCommand}" Height="38" FontWeight="SemiBold" />
            <Button Content="СТОП" Command="{Binding StopCommand}" Height="34" Margin="0,8,0,0" />

            <Separator Margin="0,24,0,16" />
            <TextBlock Text="TRUE PEAK" FontSize="11" Foreground="#9CA3AF" />
            <rendering:MeterRailView Frame="{Binding LatestFrame}" Height="250" Margin="0,10,0,0" />
        </StackPanel>

        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Background="#0B1220" CornerRadius="6" Margin="0,0,12,12" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="WATERFALL · L / R · 10 s" Foreground="#D1D5DB" Margin="14,12" FontWeight="SemiBold" VerticalAlignment="Top" />
                    <rendering:WaterfallView Frame="{Binding LatestFrame}" Margin="0,36,0,0" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Background="#0B1220" CornerRadius="6" Margin="0,0,0,12" Padding="14">
                <StackPanel>
                    <TextBlock Text="RTA" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                        <Button Content="1/1" Margin="0,0,4,0" /><Button Content="1/3" Margin="0,0,4,0" /><Button Content="1/6" Margin="0,0,4,0" /><Button Content="1/12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"><RadioButton Content="Mono" IsChecked="True" /><RadioButton Content="L" Margin="12,0,0,0" /><RadioButton Content="R" Margin="12,0,0,0" /></StackPanel>
                    <rendering:RtaView Frame="{Binding LatestFrame}" Resolution="OneThird" ChannelMode="Mono" Height="180" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Background="#0B1220" CornerRadius="6" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="LOUDNESS · EBU R128" FontWeight="SemiBold" />
                    <TextBlock Text="Momentary / Short-term / Integrated" Foreground="#9CA3AF" Margin="0,8,0,4" />
                    <TextBlock Text="Momentary    Short-term    Integrated" Foreground="#9CA3AF" />
                    <rendering:LoudnessView Frame="{Binding LatestFrame}" Height="125" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="#0B1220" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="PHASE SCOPE" FontWeight="SemiBold" />
                    <rendering:PhaseScopeView Frame="{Binding LatestFrame}" Gain="{Binding ElementName=PhaseGain, Path=Value}" Height="145" Margin="0,12,0,0" />
                    <TextBlock Text="GAIN COMPENSATION" Foreground="#9CA3AF" FontSize="10" Margin="0,12,0,0" />
                    <Slider x:Name="PhaseGain" Minimum="0.25" Maximum="4" Value="1" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#172033" CornerRadius="5" Padding="10" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
